# Copy to .env and fill in. NEVER commit real keys.
GEMINI_API_KEY=your_key_from_aistudio_google_com
GEMINI_MODEL=gemini-3.6-flash

# --- LLM backend ---------------------------------------------------------
# auto -> OmniRoute first (free/keyless router), Gemini fallback, then offline
# omniroute -> only OmniRoute (never touches the Gemini quota)
# gemini -> only the Gemini SDK
LLM_BACKEND=auto
# Local OmniRoute OpenAI-compatible endpoint (start it with: omniroute serve)
OMNIROUTE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto
OMNIROUTE_API_KEY=
OMNIROUTE_TIMEOUT=90

# --- Autonomous night factory -------------------------------------------
# MODE=night runs: scout/swarm -> HD promo videos -> nightly self-tuning.
MODE=cycle
SWARM_WORKERS=100          # logical research agents (one env, no new accounts)
SWARM_CONCURRENCY=6        # how many may hit the LLM at once
NIGHT_MAX_ASSETS=6         # assets (post+video) produced per run
MAKE_VIDEO=1              # 1 = build HD promo videos, 0 = posts only
NIGHT_HOURS=0             # >0 = grind for that many hours (24x7 host); 0 = batch

# --- Video backend -------------------------------------------------------
# builtin     = always-on $0 PIL renderer (works headless in CI).
# openmontage = ALSO emit a render brief for the OpenMontage studio (Remotion
#               + Piper TTS + open footage) driven on your 24x7 machine; the
#               builtin short is still produced so a run never ships nothing.
VIDEO_BACKEND=builtin
# Path to your OpenMontage checkout (defaults to ../OpenMontage).
# OPENMONTAGE_DIR=/Users/you/OpenMontage

# --- 24x7 deployment (VM / Docker) --------------------------------------
# AUTO_PUSH=1 makes each night run commit docs/ + state/ and push to GitHub
# Pages (Actions already pushes for you; set this only on your own box).
AUTO_PUSH=0
# GIT_AUTHOR_NAME=self-funding-agent
# GIT_AUTHOR_EMAIL=agent@users.noreply.github.com
# Continuous-host pacing (agent/night.py). On an always-on server the outer
# loop (agent/server.py or agent/watchdog.py) reruns run_night() forever, so
# these tune HOW that grind is shaped rather than whether it repeats:
#   NIGHT_MAX_ASSETS = assets per run_night() call before it returns to let
#                      reflect/evolve/ledger run (agent/server.py defaults
#                      this to 48 automatically when unset).
#   NIGHT_PACE_SECONDS = seconds to rest between each produced asset, so
#                        output is spread evenly across the day instead of
#                        bursting (agent/server.py defaults this to 180).
# NIGHT_MAX_ASSETS=48
# NIGHT_PACE_SECONDS=180

# --- Admin UI (agent/webui.py) -------------------------------------------
# Google-authenticated control panel at /admin: shows today's scouted top
# products, lets you paste your own approved affiliate link per product, and
# "Publish" kicks off content generation + marketing for just those. See the
# setup steps (Google Cloud OAuth client) in agent/webui.py's docstring.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxxxxxx
# ADMIN_ALLOWED_EMAIL=you@gmail.com
# SESSION_SECRET=              # optional; auto-generated + persisted if unset

# --- Application-server / PaaS mode (agent/server.py) --------------------
# Only used when you run `python -m agent.server` (or RUN_TARGET=server in
# Docker). Binds $PORT with /health, /status, /run for Cloud Run / Render /
# App Engine / Azure App Service etc.
# PORT=8080
# RUN_TARGET=server        # 'server' (HTTP) or 'watchdog' (pure worker)
SERVER_AUTORUN=1           # 1 = also run the autonomous loop in-process
SERVER_RUN_MODE=night      # loop mode when autorun is on
SERVER_REST_SECONDS=300    # rest between autorun iterations

# Economics (USD). Free tier -> keep costs 0.
MONTHLY_FIXED_COST=0.0
COST_PER_RUN=0.0
SURVIVAL_THRESHOLD=-5.0

# Monetization (fill when approved)
AFFILIATE_TAG=

SITE_TITLE=The Self-Funding Agent
SITE_TAGLINE=An AI writing its way to paying its own bills.

# --- Public-internet sharing (all optional; auto-post no-ops without them) ---
# All of these require YOU to create the real account first (no platform
# allows bot signups) — then the agent posts on its own forever, no further
# human input needed.
#
# Telegram public channel (free Bot API) — genuinely public sharing.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=@yourchannel
# Discord webhook (free) for a public server channel.
# DISCORD_WEBHOOK_URL=
# X / Twitter — developer.twitter.com -> Project + App (free tier) -> Keys
# and tokens -> User authentication ON, permissions Read+Write -> generate all 4.
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=
# Reddit — reddit.com/prefs/apps -> create app, type "script" -> client id
# (under the app name) + secret. Uses your normal Reddit login.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=
# REDDIT_SUBREDDIT=          # pick one that allows self-promo / buying guides
# Instagram — Business/Creator account -> link a Facebook Page -> Meta
# Developer App -> add the Instagram Graph API product -> add yourself as an
# Instagram Tester (accept the invite in the Instagram app) -> generate a
# long-lived token (instagram_basic, instagram_content_publish,
# pages_show_list, pages_read_engagement). No public App Review needed for
# single-account personal use — only the tester-approved account works.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_BUSINESS_ACCOUNT_ID=
# MEDIA_BASE_URL=https://self-funding-agent.onrender.com   # this deployment's own public URL
# Generic webhook -> Zapier/IFTTT/Make to fan out to YouTube/Facebook too.
# SOCIAL_WEBHOOK_URL=

